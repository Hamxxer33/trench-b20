# --- Public: safe in the browser bundle, set these in Vercel too ----------
NEXT_PUBLIC_FACTORY=
NEXT_PUBLIC_ROUTER=
NEXT_PUBLIC_LOCKER=
NEXT_PUBLIC_ESCROW=
NEXT_PUBLIC_PROFILES=
NEXT_PUBLIC_PLATFORM=
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=
NEXT_PUBLIC_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only: never prefix these with NEXT_PUBLIC_ ---------------------
# Service-role key from Supabase → Settings → API. Bypasses RLS, so the API
# routes are the only thing that may hold it. Leaking it into the bundle would
# hand anyone write access to the board.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Defaults to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Server-side RPC. Every indexed write costs one receipt fetch plus a couple of
# reads, so a private endpoint (Alchemy/QuickNode) beats the public one here.
# Defaults to NEXT_PUBLIC_RPC_URL.
RPC_URL=

# Optional storage tuning for /api/upload.
LOGO_BUCKET=logos
MAX_LOGO_BYTES=3145728
